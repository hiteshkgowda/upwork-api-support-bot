# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
# `.env` is git-ignored and must NEVER be committed (Assignment Rule #3).
# ---------------------------------------------------------------------------

# --- LLM endpoint (OpenAI-compatible Chat Completions) ---------------------
# Works with the Hugging Face router, a local/remote Ollama server, vLLM, etc.
#   Hugging Face router : https://router.huggingface.co/v1
#   Ollama (local)      : http://localhost:11434/v1
LLM_BASE_URL=https://your-endpoint-here/v1

# The API key / token for the endpoint above (provided to you via email).
LLM_API_KEY=your_api_key_here

# The model name to call on that endpoint.
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Sampling temperature (low = more deterministic, fact-faithful answers).
LLM_TEMPERATURE=0.1

# --- Source documentation -------------------------------------------------
# Path to the Upwork API reference (pdf / txt / md). Defaults to the bundled
# PDF if left unset.
SOURCE_DOC_PATH=data/upwork_api_reference.pdf

# --- Optional overrides (sensible defaults live in config.py) --------------
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=3
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
